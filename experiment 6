#include <iostream>
using namespace std;

class Complex {
    int real, imag;

public:
    Complex(int r = 0, int i = 0) {
        real = r;
        imag = i;
    }

    void display() {
        cout << real << " + " << imag << "i" << endl;
    }

    Complex operator+(Complex c) {
        return Complex(real + c.real, imag + c.imag);
    }
};

int add(int a, int b) {
    return a + b;
}

float add(float a, float b) {
    return a + b;
}

int main() {
    Complex c1(3, 4), c2(2, 5), c3;

    c3 = c1 + c2;

    cout << "Complex Number 1: ";
    c1.display();

    cout << "Complex Number 2: ";
    c2.display();

    cout << "Addition: ";
    c3.display();

    cout << "Integer Addition: " << add(5, 10) << endl;
    cout << "Float Addition: " << add(2.5f, 3.5f) << endl;

    return 0;
}
