#include <iostream>
using namespace std;

class Student {
private:
    string name;
protected:
    int DOB;
public:
    void getData() {
        cout << "Enter name: ";
        cin >> name;
        cout << "Enter year of birth: ";
        cin >> DOB;
    }
    void display() {
        cout << "Name: " << name << endl;
        cout << "Year of Birth: " << DOB << endl;
    }
};

class GraduateStudent : public Student {
private:
    string course;
public:
    void getCourse() {
        cout << "Enter course: ";
        cin >> course;
    }
    void show() {
        display();
        cout << "Course: " << course << endl;
        cout << "Age: " << 2026 - DOB << endl;
    }
};

int main() {
    GraduateStudent s;
    s.getData();
    s.getCourse();
    s.show();
    return 0;
}
