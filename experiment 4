#include <iostream>
using namespace std;

class Person {
public:
    string name;

    void displayPerson() {
        cout << "Name: " << name << endl;
    }
};

class Student : public Person {
public:
    int rollNo;

    void displayStudent() {
        displayPerson();
        cout << "Roll No: " << rollNo << endl;
    }
};

class GraduateStudent : public Student {
public:
    string course;

    void displayGraduate() {
        displayStudent();
        cout << "Course: " << course << endl;
    }
};

int main() {
    GraduateStudent s;

    cout << "Enter name: ";
    cin >> s.name;

    cout << "Enter roll number: ";
    cin >> s.rollNo;

    cout << "Enter course: ";
    cin >> s.course;

    s.displayGraduate();

    return 0;
}
